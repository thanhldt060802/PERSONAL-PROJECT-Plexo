# Phải trùng STACK_NAME trong infrastructure/.env
STACK_NAME=plexo-prod

# Tag image: prod = latest / v1.0.2 / <sha> (build khi tạo tag version từ main) — dev = develop-latest / develop-<sha>
IMAGE_TAG=latest
DOCKERHUB_USERNAME=thanhldt060802

# prod: plexo.thanhldt.site / api.plexo.thanhldt.site — dev: plexo-dev.thanhldt.site / api.plexo-dev.thanhldt.site
WEB_DOMAIN=plexo.thanhldt.site
API_DOMAIN=api.plexo.thanhldt.site

# Trùng auth.cookie_name trong config.json của Admin_Service
SESSION_COOKIE_NAME=plexo_session
