# Tên stack = <app>-<env>: plexo-prod (server, bản phát hành) / plexo-dev (server, nhánh develop) / plexo-local (máy dev).
# Mọi container, network, compose project đặt theo tên này — phải trùng STACK_NAME trong service/.env.
STACK_NAME=plexo-prod

# Port Postgres / Redis mở cho 127.0.0.1 — mỗi stack trên cùng máy một port (ví dụ prod 5432/6379, dev 5433/6380)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=?

REDIS_PORT=6379

# Token tunnel Cloudflare của stack (Zero Trust → Networks → Tunnels); mỗi môi trường một tunnel. Local: để trống.
CLOUDFLARE_TUNNEL_TOKEN=?
